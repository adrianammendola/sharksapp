rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY: Ultra-permissive rules to debug permission issues
    // After fixing, we can tighten these
    
    // Function to check if the user is an admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Rules for players subcollection
    match /users/{userId}/jugadores/{jugadorId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Rules for matches subcollection - ULTRA PERMISSIVE FOR DEBUGGING
    match /users/{userId}/partidos/{partidoId} {
      // Allow read to ANY authenticated user
      allow read: if request.auth != null;
      
      // Allow create for any authenticated user
      allow create: if request.auth != null;
      
      // Allow update/delete for owner or admin
      allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Rules for comments sub-subcollection
      match /comments/{commentId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      }
    }
  }
}
